<Window x:Class="SportCenterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sport Center - Hệ Thống Quản Lý &amp; Đặt Lớp Học Thể Thao" 
        Height="800" Width="1280"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation (Clean White Surface) -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="18,24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="0" Opacity="0.04" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SPORT CENTER" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="PRO MANAGEMENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TealAccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Active User Profile Card -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- User Circle Avatar -->
                        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" CornerRadius="21" Width="38" Height="38" HorizontalAlignment="Left">
                            <TextBlock x:Name="TxtUserAvatar" Text="U" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtUserName" Text="Demo Administrator" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <Border x:Name="BorderRoleBadge" Background="#DBEAFE" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,3,0,0">
                                <TextBlock x:Name="TxtRoleBadge" Text="👑 QUẢN LÝ" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation Menu Links -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Manager Section -->
                        <StackPanel x:Name="PanelManagerNav" Visibility="Visible">
                            <TextBlock Text="CHỨC NĂNG QUẢN LÝ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,8" />
                            <Button x:Name="BtnNavManagerDashboard" Content="📊 Danh sách lớp &amp; Báo cáo" Style="{StaticResource OutlineButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,8" Click="OnNavManagerDashboardClick" />
                            <Button x:Name="BtnNavCreateClass" Content="➕ Tạo Khóa &amp; Mở Lớp Học" Style="{StaticResource OutlineButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,16" Click="OnNavCreateClassClick" />
                        </StackPanel>

                        <!-- Customer Section -->
                        <StackPanel x:Name="PanelCustomerNav" Visibility="Visible">
                            <TextBlock Text="CHỨC NĂNG HỌC VIÊN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,8" />
                            <Button x:Name="BtnNavCustomerCatalog" Content="🏃 Đặt Khóa Học Mới" Style="{StaticResource OutlineButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,8" Click="OnNavCustomerCatalogClick" />
                            <Button x:Name="BtnNavCustomerEnrollments" Content="📋 Lớp của tôi &amp; Feedback" Style="{StaticResource OutlineButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,16" Click="OnNavCustomerEnrollmentsClick" />
                        </StackPanel>

                        <!-- Coach Section -->
                        <StackPanel x:Name="PanelCoachNav" Visibility="Visible">
                            <TextBlock Text="CHỨC NĂNG HUẤN LUYỆN VIÊN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,8" />
                            <Button x:Name="BtnNavCoachAttendance" Content="🎯 Điểm danh lớp học" Style="{StaticResource OutlineButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,8" Click="OnNavCoachAttendanceClick" />
                            <Button x:Name="BtnNavCoachFeedback" Content="💬 Đánh giá từ học viên" Style="{StaticResource OutlineButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,16" Click="OnNavCoachFeedbackClick" />
                        </StackPanel>

                        <Separator Background="{StaticResource BorderSubtleBrush}" Margin="4,8,4,14" />

                        <!-- Role Switcher for Testing / Demo -->
                        <TextBlock Text="CHUYỂN VAI TRÒ NHANH (DEMO):" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,8" />
                        <ComboBox x:Name="CmbSwitchRole" Height="34" Margin="0,0,0,8" SelectionChanged="OnSwitchRoleChanged">
                            <ComboBoxItem Content="👔 Manager (Quản lý)" Tag="ADMIN" />
                            <ComboBoxItem Content="🥋 Coach (Huấn luyện viên)" Tag="COACH" />
                            <ComboBoxItem Content="👤 Customer (Học viên)" Tag="CUSTOMER" />
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Logout Button -->
                <Button Grid.Row="3" Content="🚪 Đăng Xuất" Style="{StaticResource OutlineButtonStyle}" HorizontalContentAlignment="Center" Margin="0,16,0,0" Click="OnLogoutClick" />
            </Grid>
        </Border>

        <!-- Right Main View Container -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar (White Card) -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Active View Title -->
                    <TextBlock x:Name="TxtActiveViewTitle" Text="Tổng Quan Quản Lý &amp; Khóa Học" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                    <!-- Status indicators -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🟢 " FontSize="9" VerticalAlignment="Center" />
                                <TextBlock Text="SQL: SportCenterDB" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TxtCurrentTime" Text="15:30" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area (Loads Views) -->
            <ContentControl x:Name="MainContentArea" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
