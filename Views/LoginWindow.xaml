<Window x:Class="SportCenterApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SportCenter - Đăng Nhập Hệ Thống" 
        Height="650" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        ResizeMode="CanMinimize">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Branding Panel (Clean White Card) -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="35,40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Direction="0" Opacity="0.05" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0">
                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="12" Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,18">
                        <TextBlock Text="⚡" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    </Border>
                    <TextBlock Text="SPORT CENTER" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="Quản lý &amp; Đặt khóa học Thể thao" FontSize="13" Foreground="{StaticResource TealAccentBrush}" FontWeight="SemiBold" />
                </StackPanel>

                <!-- Description / Pillars -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20">
                    <Border Background="#EFF6FF" CornerRadius="8" Padding="14,12" Margin="0,0,0,14" BorderBrush="#BFDBFE" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="👑 Dành cho Quản lý" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,0,4" />
                            <TextBlock Text="Tạo lớp học, gán Huấn luyện viên, quản lý số lượng và hiển thị trực tiếp lên hệ thống." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#ECFDF5" CornerRadius="8" Padding="14,12" Margin="0,0,0,14" BorderBrush="#A7F3D0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🎯 Dành cho Huấn luyện viên" FontWeight="Bold" Foreground="#047857" Margin="0,0,0,4" />
                            <TextBlock Text="Theo dõi danh sách lớp phụ trách, điểm danh học viên từng buổi học, xem phản hồi." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#FEF3C7" CornerRadius="8" Padding="14,12" BorderBrush="#FDE68A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🏃 Dành cho Học viên" FontWeight="Bold" Foreground="#B45309" Margin="0,0,0,4" />
                            <TextBlock Text="Khám phá khóa học, đăng ký &amp; thanh toán nhanh, theo dõi lịch và gửi đánh giá (Feedback)." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <TextBlock Grid.Row="2" Text="PRN211 WPF Application • SQL Server SportCenter" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Right Login Panel (Light Surface) -->
        <Border Grid.Column="1" Background="#F8FAFC" Padding="45,40" VerticalAlignment="Center">
            <StackPanel MaxWidth="380">
                <TextBlock Text="Chào mừng trở lại!" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBlock Text="Chọn vai trò thử nghiệm hoặc đăng nhập bằng tài khoản:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20" />

                <!-- Quick Role Buttons -->
                <TextBlock Text="ĐĂNG NHẬP NHANH (DEMO ACCOUNTS):" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="👔 Manager" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,4,0" Click="OnQuickManagerClick" ToolTip="Tài khoản Quản lý" />
                    <Button Grid.Column="1" Content="🥋 Coach" Style="{StaticResource OutlineButtonStyle}" Margin="4,0,4,0" Click="OnQuickCoachClick" ToolTip="Tài khoản Huấn luyện viên" />
                    <Button Grid.Column="2" Content="👤 Customer" Style="{StaticResource OutlineButtonStyle}" Margin="4,0,0,0" Click="OnQuickCustomerClick" ToolTip="Tài khoản Học viên" />
                </Grid>

                <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,22" />

                <!-- Form -->
                <TextBlock Text="Email đăng nhập" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="TxtEmail" Text="demo.admin@sportcenter.test" Margin="0,0,0,16" Height="38" VerticalContentAlignment="Center" />

                <TextBlock Text="Mật khẩu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <PasswordBox x:Name="TxtPassword" Password="admin" Margin="0,0,0,10" Height="38" VerticalContentAlignment="Center" />

                <TextBlock Text="* Mật khẩu thử nghiệm: 123456 hoặc click nút chọn vai trò bên trên" FontSize="11" Foreground="#64748B" Margin="0,0,0,20" />

                <!-- Error Message -->
                <Border x:Name="BorderError" Background="#FEE2E2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- Login Button -->
                <Button x:Name="BtnLogin" Content="ĐĂNG NHẬP VÀO HỆ THỐNG" Style="{StaticResource PrimaryButtonStyle}" Height="42" Click="OnLoginClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
