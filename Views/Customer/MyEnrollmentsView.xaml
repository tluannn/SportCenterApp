<UserControl x:Class="SportCenterApp.Views.Customer.MyEnrollmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDarkBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header (White Card) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Direction="270" Opacity="0.04" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="📋 Khóa Học Của Tôi &amp; Lịch Sử Thanh Toán" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Danh sách các lớp thể thao bạn đã đăng ký, thông tin hóa đơn và đánh giá phản hồi (Feedback)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="🔄 Tải lại" Style="{StaticResource OutlineButtonStyle}" VerticalAlignment="Center" Click="OnRefreshClick" />
            </Grid>
        </Border>

        <!-- Enrollments DataGrid (White Card) -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Direction="270" Opacity="0.04" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <DataGrid x:Name="DgEnrollments" SelectionMode="Single" IsReadOnly="True" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MÃ ĐK" Binding="{Binding RegistrationId, Mode=OneWay}" Width="65" IsReadOnly="True" />

                    <DataGridTemplateColumn Header="LỚP HỌC &amp; MÔN" Width="2.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ClassName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding SportName}" FontSize="11" Foreground="{StaticResource TealAccentBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="HLV PHỤ TRÁCH" Binding="{Binding CoachName, Mode=OneWay}" Width="1.5*" IsReadOnly="True" />
                    <DataGridTextColumn Header="NGÀY ĐĂNG KÝ" Binding="{Binding RegisteredAtFormatted, Mode=OneWay}" Width="1.5*" IsReadOnly="True" />
                    <DataGridTextColumn Header="HỌC PHÍ ĐÃ TRẢ" Binding="{Binding FinalPriceFormatted, Mode=OneWay}" Width="1.3*" IsReadOnly="True" />

                    <DataGridTemplateColumn Header="THANH TOÁN" Width="1.8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PaymentMethod, StringFormat='{}PT: {0}'}" FontWeight="SemiBold" Foreground="#059669" />
                                    <TextBlock Text="{Binding TransactionCode}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ĐÁNH GIÁ (FEEDBACK)" Width="2.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FeedbackStatusText}" Foreground="#D97706" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Content="⭐ Viết Đánh Giá" Style="{StaticResource OutlineButtonStyle}" Padding="8,4" FontSize="11" Tag="{Binding}" Click="OnOpenFeedbackClick" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
