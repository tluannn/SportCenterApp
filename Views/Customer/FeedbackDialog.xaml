<Window x:Class="SportCenterApp.Views.Customer.FeedbackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gửi Đánh Giá Lớp Học (Feedback)" 
        Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        ResizeMode="NoResize">

    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="⭐ Đánh Giá Lớp Học (Feedback)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="TxtClassSubtitle" Text="Lớp: Demo Badminton Class" FontSize="13" Foreground="{StaticResource TealAccentBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Body -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="Mức độ hài lòng của bạn *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

                <!-- Star Rating Options (Soft Light Card) -->
                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="RbStar1" Grid.Column="0" Content="⭐ 1" GroupName="Rating" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <RadioButton x:Name="RbStar2" Grid.Column="1" Content="⭐ 2" GroupName="Rating" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <RadioButton x:Name="RbStar3" Grid.Column="2" Content="⭐ 3" GroupName="Rating" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <RadioButton x:Name="RbStar4" Grid.Column="3" Content="⭐ 4" GroupName="Rating" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <RadioButton x:Name="RbStar5" Grid.Column="4" Content="⭐ 5" GroupName="Rating" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" IsChecked="True" />
                    </Grid>
                </Border>

                <TextBlock Text="Nhận xét chi tiết về giảng dạy, HLV &amp; cơ sở vật chất:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="TxtComment" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10" Margin="0,0,0,14" />

                <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Hủy" Style="{StaticResource OutlineButtonStyle}" Width="90" Margin="0,0,10,0" Click="OnCancelClick" />
                <Button x:Name="BtnSubmit" Content="🚀 Gửi Đánh Giá" Style="{StaticResource PrimaryButtonStyle}" Width="150" Click="OnSubmitClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
