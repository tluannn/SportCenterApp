<UserControl x:Class="SportCenterApp.Views.Coach.CoachAttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDarkBrush}">

    <UserControl.Resources>
        <!-- Light Theme DataGrid Style for Attendance -->
        <Style x:Key="LightAttendanceDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="RowHeight" Value="64" />
        </Style>

        <!-- Column Header Style with ample padding & crisp dark text -->
        <Style x:Key="LightColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              TextElement.Foreground="#0F172A" 
                                              TextBlock.Foreground="#0F172A"
                                              TextElement.FontWeight="Bold"
                                              TextBlock.FontWeight="Bold" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cell Style - Clean without harsh focus borders -->
        <Style x:Key="LightDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="Transparent" 
                                BorderThickness="0" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="#0F172A" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Status ComboBox Item Style for Dropdown list -->
        <Style x:Key="StatusOptionItemStyle" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="Bold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="BorderThickness" Value="2.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Attendance Status ComboBox Style (Full Box Pill) -->
        <Style x:Key="AttendanceStatusComboBoxStyle" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Clickable closed pill button (Full Box Stretch) -->
                            <ToggleButton x:Name="toggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="btnBorder"
                                                Background="{Binding StatusBackground, Mode=OneWay}"
                                                BorderBrush="{Binding StatusBorder, Mode=OneWay}"
                                                BorderThickness="1.5"
                                                CornerRadius="7"
                                                Padding="12,0">
                                            <Grid>
                                                <TextBlock Text="{Binding StatusDisplayText, Mode=OneWay}"
                                                           Foreground="{Binding StatusForeground, Mode=OneWay}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left" />
                                                <Path x:Name="arrow"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{Binding StatusForeground, Mode=OneWay}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Dropdown popup -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,8"
                                        Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.15" ShadowDepth="4" Color="Black" />
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Session Selector (White Card) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="🎯 Điểm Danh Học Viên Lớp Học (Attendance)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Chọn buổi học phụ trách để cập nhật chuyên cần cho học viên" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Session Pick Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Chọn Buổi học:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbSessions" Grid.Column="1" DisplayMemberPath="DisplayText" SelectedValuePath="SessionId" Height="38" Margin="0,0,12,0" SelectionChanged="OnSessionChanged" />
                    <Button Grid.Column="2" Content="🔄 Tải lại" Style="{StaticResource OutlineButtonStyle}" Click="OnRefreshClick" />
                </Grid>
            </Grid>
        </Border>

        <!-- Quick Actions & Session Info (White Card) -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSessionDetails" Text="Đang chọn: Chưa có buổi học nào được chọn" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                    <TextBlock x:Name="TxtAttendanceStats" Text="Sĩ số: 0 học viên" FontSize="12" Foreground="{StaticResource TealAccentBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚡ Đặt tất cả 'Có mặt'" Style="{StaticResource OutlineButtonStyle}" Padding="14,8" Margin="0,0,10,0" Click="OnMarkAllPresentClick" />
                    <Button x:Name="BtnSaveAttendance" Content="💾 Lưu Điểm Danh" Style="{StaticResource SuccessButtonStyle}" Padding="20,8" Height="36" Click="OnSaveAttendanceClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Attendance Sheet Table (White Card with DropShadow) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.06" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <Grid>
                <DataGrid x:Name="DgAttendance" 
                          Style="{StaticResource LightAttendanceDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource LightColumnHeaderStyle}"
                          CellStyle="{StaticResource LightDataGridCellStyle}">
                    <DataGrid.Columns>
                        <!-- ID Column (Widened so MÃ HV is never cut off) -->
                        <DataGridTextColumn Header="MÃ HV" Binding="{Binding MemberId}" Width="85" IsReadOnly="True" HeaderStyle="{StaticResource LightColumnHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#64748B" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Student Name & Email (Ample room, no clipping) -->
                        <DataGridTemplateColumn Header="HỌ VÀ TÊN HỌC VIÊN" Width="2.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" Foreground="#0F172A" FontSize="13.5" />
                                        <TextBlock Text="{Binding Email}" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Phone Column -->
                        <DataGridTextColumn Header="SỐ ĐIỆN THOẠI" Binding="{Binding Phone}" Width="1.3*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#334155" />
                                    <Setter Property="FontSize" Value="13" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status Picker Column (Full Box Stretch, Colored Pill) -->
                        <DataGridTemplateColumn Header="TRẠNG THÁI ĐIỂM DANH" Width="215">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedValue="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              SelectedValuePath="Tag" 
                                              Style="{StaticResource AttendanceStatusComboBoxStyle}">
                                        <ComboBoxItem Tag="PRESENT" Style="{StaticResource StatusOptionItemStyle}" Background="#DCFCE7" BorderBrush="#16A34A" Foreground="#15803D" Content="✅ Có mặt (Present)" />
                                        <ComboBoxItem Tag="ABSENT" Style="{StaticResource StatusOptionItemStyle}" Background="#FEE2E2" BorderBrush="#DC2626" Foreground="#B91C1C" Content="❌ Vắng mặt (Absent)" />
                                        <ComboBoxItem Tag="LATE" Style="{StaticResource StatusOptionItemStyle}" Background="#FEF3C7" BorderBrush="#D97706" Foreground="#B45309" Content="⏰ Đi muộn (Late)" />
                                        <ComboBoxItem Tag="EXCUSED" Style="{StaticResource StatusOptionItemStyle}" Background="#E0E7FF" BorderBrush="#4F46E5" Foreground="#3730A3" Content="📝 Có phép (Excused)" />
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Note Column (Full Box Stretch) -->
                        <DataGridTemplateColumn Header="GHI CHÚ BUỔI HỌC" Width="2.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="38" 
                                             HorizontalAlignment="Stretch"
                                             VerticalContentAlignment="Center" 
                                             Background="#FFFFFF" 
                                             Foreground="#0F172A" 
                                             BorderBrush="#CBD5E1" 
                                             BorderThickness="1"
                                             Padding="10,0"
                                             FontSize="12.5"
                                             CaretBrush="#0F172A" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Last Marked Info -->
                        <DataGridTemplateColumn Header="LẦN ĐIỂM DANH GẦN NHẤT" Width="1.7*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <!-- When Marked -->
                                        <StackPanel Visibility="{Binding HasBeenMarked, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding MarkedByName, StringFormat='{}Bởi: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#2563EB" />
                                            <TextBlock Text="{Binding MarkedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <!-- When Not Marked -->
                                        <TextBlock Text="— Chưa điểm danh —" FontSize="11.5" FontStyle="Italic" Foreground="#94A3B8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasBeenMarked}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Message -->
                <TextBlock x:Name="TxtNoStudents" Text="Không có học viên đăng ký hoặc chưa chọn buổi học." FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
