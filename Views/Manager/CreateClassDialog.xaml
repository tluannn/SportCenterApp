<Window x:Class="SportCenterApp.Views.Manager.CreateClassDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo Khóa Học &amp; Mở Lớp Học Thể Thao (Dành cho Admin)" 
        Height="680" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        ResizeMode="NoResize">

    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="➕ Tạo Khóa Học &amp; Mở Lớp Học Mới" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Quy trình 2 bước: Điền thông tin Khóa học trước ➔ Sau đó thiết lập Lớp học &amp; gán Huấn luyện viên" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Step Progress Indicator -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Step 1 Indicator -->
                    <Border x:Name="IndicatorStep1" Grid.Column="0" Background="{StaticResource PrimaryBrush}" CornerRadius="6" Padding="12,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="1️⃣" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtIndicatorStep1" Text="BƯỚC 1: THIẾT LẬP KHÓA HỌC" FontWeight="Bold" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="1" Text="➔" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- Step 2 Indicator -->
                    <Border x:Name="IndicatorStep2" Grid.Column="2" Background="Transparent" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="2️⃣" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtIndicatorStep2" Text="BƯỚC 2: TẠO LỚP &amp; GÁN HLV" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Form Content Areas -->
            <Grid Grid.Row="2">
                <!-- STEP 1 PANEL -->
                <ScrollViewer x:Name="PanelStep1" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="THÔNG TIN KHÓA HỌC" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TealAccentBrush}" Margin="0,0,0,12" />

                        <!-- Sport Picker -->
                        <TextBlock Text="Môn thể thao *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ComboBox x:Name="CmbSports" DisplayMemberPath="Name" SelectedValuePath="Id" Height="36" Margin="0,0,0,14" SelectionChanged="OnSportChanged" />

                        <!-- Course Name -->
                        <TextBlock Text="Tên khóa học *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtCourseName" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,14" />

                        <!-- Level & Price in 2 Columns -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Trình độ khóa học" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <ComboBox x:Name="CmbLevel" Height="36">
                                    <ComboBoxItem Content="Cơ bản (Beginner)" IsSelected="True" />
                                    <ComboBoxItem Content="Trung cấp (Intermediate)" />
                                    <ComboBoxItem Content="Nâng cao (Advanced)" />
                                    <ComboBoxItem Content="Mọi trình độ (All Levels)" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Học phí toàn khóa (VNĐ) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBox x:Name="TxtPrice" Text="250000" Height="36" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Planned Sessions & Duration in 2 Columns -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số buổi học dự kiến *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBox x:Name="TxtPlannedSessions" Text="10" Height="36" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Thời lượng mỗi buổi (phút) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBox x:Name="TxtSessionDuration" Text="60" Height="36" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Date Range in 2 Columns -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ngày khai giảng (dd/MM/yyyy) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBox x:Name="TxtStartDate" Height="36" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ngày bế giảng (dd/MM/yyyy) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBox x:Name="TxtEndDate" Height="36" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Description -->
                        <TextBlock Text="Mô tả khóa học (tùy chọn)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtDescription" Height="50" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6" />
                    </StackPanel>
                </ScrollViewer>

                <!-- STEP 2 PANEL -->
                <ScrollViewer x:Name="PanelStep2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,10,0">
                        <!-- Course Summary Banner -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="📌 KHÓA HỌC ĐÃ THIẾT LẬP Ở BƯỚC 1:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TealAccentBrush}" Margin="0,0,0,6" />
                                <TextBlock x:Name="TxtSummaryCourseTitle" Text="Khóa Học Cầu Lông Cơ Bản" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="TxtSummaryDetails" Text="Môn: Cầu Lông • Học phí: 250,000 đ • 10 buổi (60p/buổi)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="TxtSummaryDates" Text="Thời gian: 15/11/2026 - 15/12/2026" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="THÔNG TIN LỚP HỌC &amp; GÁN HUẤN LUYỆN VIÊN" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TealAccentBrush}" Margin="0,0,0,12" />

                        <!-- Class Name -->
                        <TextBlock Text="Tên lớp học cụ thể *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtClassName" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,14" />

                        <!-- Coach Picker -->
                        <TextBlock Text="Gán Huấn luyện viên phụ trách (Coach) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ComboBox x:Name="CmbCoaches" DisplayMemberPath="DisplayText" SelectedValuePath="CoachId" Height="36" Margin="0,0,0,14" />

                        <!-- Capacity & Status in 2 Columns -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sức chứa tối đa (Học viên) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBox x:Name="TxtCapacity" Text="15" Height="36" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Trạng thái lớp" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <ComboBox x:Name="CmbStatus" Height="36">
                                    <ComboBoxItem Content="ACTIVE" IsSelected="True" />
                                    <ComboBoxItem Content="INACTIVE" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Border Background="#EFF6FF" CornerRadius="6" Padding="12,10" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,6,0,0">
                            <TextBlock Text="💡 Khi lưu thành công, hệ thống sẽ tự động tạo Khóa học, Gói khóa học, mở Lớp học và sinh toàn bộ lịch các buổi học để HLV có thể điểm danh ngay lập tức." FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Error Banner -->
            <TextBlock x:Name="TxtMessage" Grid.Row="2" VerticalAlignment="Bottom" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed" />

            <!-- Actions Footer -->
            <Border Grid.Row="3" Margin="0,16,0,0">
                <Grid>
                    <!-- Step 1 Footer Buttons -->
                    <Grid x:Name="FooterStep1" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Hủy bỏ" Style="{StaticResource OutlineButtonStyle}" Width="100" HorizontalAlignment="Left" Click="OnCancelClick" />
                        <Button Grid.Column="1" Content="Tiếp tục: Bước 2 (Tạo Lớp &amp; Gán HLV) ➔" Style="{StaticResource PrimaryButtonStyle}" Click="OnGoToStep2Click" />
                    </Grid>

                    <!-- Step 2 Footer Buttons -->
                    <Grid x:Name="FooterStep2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="⬅ Quay lại Bước 1" Style="{StaticResource OutlineButtonStyle}" Width="140" Click="OnBackToStep1Click" />
                        <Button x:Name="BtnSave" Grid.Column="2" Content="💾 Hoàn Tất Tạo Khóa &amp; Mở Lớp" Style="{StaticResource PrimaryButtonStyle}" Padding="18,10" Click="OnSaveClick" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
